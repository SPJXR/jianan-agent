# ===== 建安法规问答助手 管理员配置说明 =====
# 复制本文件为 .env 并填写后重启服务生效。
# API Key 仅存于服务端，不会出现在前端代码与网络请求中（PRD 安全要求）。

# ---- LLM 模型服务（OpenAI 兼容接口）----
# 阿里云 DashScope：
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus / qwen-turbo / qwen-max
# DeepSeek（https://platform.deepseek.com 创建 Key）：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat（或 deepseek-reasoner）
# 本地 Ollama 示例：
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- 生成参数（可选）----
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_FIRST=60
LLM_TIMEOUT_TOTAL=120

# ---- 应用（可选）----
APP_HOST=127.0.0.1
APP_PORT=9000
# 每 IP 每分钟最大提问次数（防 Key 盗刷，PRD P0）
RATE_LIMIT_PER_MIN=20
# 检索返回条数与"未找到"兜底的相关度阈值
RETRIEVAL_TOP_K=8
MIN_COVERAGE=0.25
# 统计端点 /api/track/stats 的访问口令。
#   留空 = 仅允许本机（127.0.0.1/::1）访问，公网请求一律 403；
#   设置后 = 必须带 ?token=xxx 或请求头 X-Track-Token。
# 公网部署要远程看统计就设一个随机串：openssl rand -hex 16
TRACK_STATS_TOKEN=
